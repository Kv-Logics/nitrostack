# Leave blank for the default same-origin /api routes. During `npm run dev`,
# Vite proxies them to the integrated ForgeOps API on port 8787.
VITE_FORGEOPS_API_URL=

# Backward-compatible overrides remain supported:
# VITE_ROLE3_API_URL=http://localhost:8787
# VITE_ROLE1_AGENT_URL=http://localhost:8787/api/agent/query
# Agent backend (NitroCloud hosts the provider credential; no OpenAI/Gemini key is needed here)
NITROCHAT_BASE_URL=https://nitrochat-zenops-chat-6a64-zen-net-amrita-university-coimbatore.app.nitrocloud.ai
FORGEOPS_MCP_URL=https://zenops-6a649dab-zen-net-amrita-university-coimbatore.app.nitrocloud.ai/mcp
FORGEOPS_MODEL=google/gemini-3.5-flash-lite
FORGEOPS_LIVE_AGENTS=true
FORGEOPS_HTTP_TIMEOUT_SECONDS=45
